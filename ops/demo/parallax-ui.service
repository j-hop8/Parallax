# Public demo page (T-029): the Streamlit UI, on loopback, behind Caddy.
# Rendered by `make demo.install` (@@ROOT@@, and @@GROUP@@ = the crawl user's
# group). It lives outside ops/systemd/ on purpose:
# `make sched.install` installs every unit in there, and scheduling the crawl
# must never put a web server on the host as a side effect.
#
# This page shares a host with tier 1, whose uptime is invariant 1. So it is
# the process the kernel gives up first -- a memory cap, a positive OOM score,
# a lower CPU priority -- and it reads Postgres as parallax_ro
# (db/migrations/004): read-only, statement_timeout, connection limit.
[Unit]
Description=Parallax public demo page (Streamlit on 127.0.0.1:8501)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Its own identity, never the crawl's (T-034). Sandboxing the crawl's user is
# not enough: any process of that user can walk /proc/<crawl-pid>/root back
# into the host filesystem -- .env (the owner database URL) and the Docker
# socket (root on this host) included. A transient DynamicUser cannot: .env
# is 0600 to its owner (demo.install enforces it), the socket is root:docker
# 0660, and /proc/<pid>/root of another user's process is refused. It reads
# the code through the crawl user's group, which the 0750 home allows.
# DynamicUser also implies ProtectSystem=strict, ProtectHome=read-only,
# PrivateTmp, NoNewPrivileges and RestrictSUIDSGID.
DynamicUser=yes
SupplementaryGroups=@@GROUP@@
WorkingDirectory=@@ROOT@@
Environment=HOME=/tmp
# PARALLAX_DATABASE_URL as parallax_ro, written by demo.install (mode 600).
# systemd reads it as root before dropping to the page's user; an exported
# variable wins over .env, so the owner URL never reaches this process.
EnvironmentFile=@@ROOT@@/.env.ui
# Belt and braces on top of the identity: not even the paths exist in here.
InaccessiblePaths=-@@ROOT@@/.env -/run/docker.sock -/var/run/docker.sock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# The venv's interpreter, not `uv run`: this user may not write the venv or
# uv's cache, and every deploy already syncs it (uv sync --extra ui).
ExecStart=@@ROOT@@/.venv/bin/python -m streamlit run src/parallax/ui/app.py --server.address=127.0.0.1 --server.port=8501
Restart=always
RestartSec=5
MemoryMax=768M
OOMScoreAdjust=500
Nice=10

[Install]
WantedBy=multi-user.target
