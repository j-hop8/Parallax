# Copy to <repo>/.env on the VPS. settings.py reads this file; docker compose
# reads it too (same directory). Never commit .env.

# Postgres superuser password for the compose service. The default in
# docker-compose.yml is "parallax", fine on a laptop bound to localhost, not
# on a shared host. Generate one: openssl rand -hex 24
PARALLAX_DB_PASSWORD=change-me

# Must carry the same password. Port 5433 is the compose mapping; the host
# binding is loopback-only, so this URL is reachable from the VPS itself and,
# on the laptop, through `ssh -L 5433:127.0.0.1:5433 <vps>`.
PARALLAX_DATABASE_URL=postgresql://parallax:change-me@127.0.0.1:5433/parallax

# Optional crawl heartbeat: create a free healthchecks.io check with a
# 10-minute period and 30-minute grace, enable email alerts, and paste its
# secret ping URL here on the crawl host. Leave unset to disable pings.
# PARALLAX_HEARTBEAT_URL=https://hc-ping.com/<check-uuid>

# Only needed where tier 2 runs (enrich / stance / framing --summarize). The
# VPS runs tier 1 only and does not need it.
# GEMINI_API_KEY=

# laptop only — tier 2 secret. Refresh monthly with make threads.refresh;
# replace this value manually (60-day lifetime; expired tokens need reauthorization).
# THREADS_ACCESS_TOKEN=
