# Raw HTML cache — content-addressed, regenerable, and large. Never committed.
raw/
logs/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Models and datasets produced by training runs
models/
*.safetensors
*.bin

# Gold-set labels ARE committed (eval/*.csv) — they are hand-made and irreplaceable.
# Model outputs and scratch are not.
eval/runs/

.DS_Store
.env

# 8.2MB jieba traditional dictionary, fetched by `make dict`
config/dict.txt.big

# pg_dump output (make db.dump, the VPS backup timer) and ops.check scratch.
backups/
.ops-check/

# Knowledge graph generated by /graphify from the repo itself — regenerable.
graphify-out/
