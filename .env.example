# Copy to .env and fill in. .env is gitignored; this file documents the names.
# Loaded by src/parallax/settings.py for every job; real env vars take precedence.

# Google AI Studio key for the stance classifier (T-007). Free tier is enough.
GEMINI_API_KEY=

# Optional overrides (defaults in settings.py).
# STANCE_MODEL=gemini-3.5-flash-lite     # must have a free tier on your account
# STANCE_RPM=10                      # client-side pacing; raise after checking AI Studio
# FRAMING_MODEL=gemini-3.5-flash-lite    # Q3 delta summaries; defaults to STANCE_MODEL

# Workstation, after the VM cutover (ops/README.md §8, §11, §12): the VM's ssh
# address, for the tunnel (make tunnel.install) and make backup.pull.
# PARALLAX_VM_HOST=parallax@<vps-ip>
# Split setup (§12): this Mac crawls only the outlets that refuse datacenter IPs,
# and proves it with its own healthchecks.io check.
# PARALLAX_CRAWL_OUTLETS=chinatimes,ftv
# PARALLAX_HEARTBEAT_URL=https://hc-ping.com/<the Mac's check>
