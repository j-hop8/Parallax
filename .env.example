# Copy to .env and fill in. .env is gitignored; this file documents the names.
# Loaded by src/parallax/settings.py for every job; real env vars take precedence.

# Google AI Studio key for the stance classifier (T-007). Free tier is enough.
GEMINI_API_KEY=

# Optional overrides (defaults in settings.py).
# STANCE_MODEL=gemini-3.5-flash-lite     # must have a free tier on your account
# STANCE_RPM=10                      # client-side pacing; raise after checking AI Studio
